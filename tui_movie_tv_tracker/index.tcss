Screen {
}

Pane {
	width: 1fr;
	border: solid white;
	height: 1fr;
}

.pane-window {
	border: solid white;
	padding: 0 1;
	background: transparent;
	color: rgba(255, 255, 255, 0.7);
	opacity: 0.7;
}

.pane-window:focus-within {
	border: double blue;
	opacity: 1;
	color: rgba(255, 255, 255, 1);
}

.pane-window > ListView {
	background: transparent;
}

ModalScreen {
	align: center middle;
	background: rgba(0, 0, 0, 0.5); 
}

.modal-container {
	width: 60;
	height: auto;
	padding: 1;
	background: transparent;
	border: solid blue;
}

.modal-input {
	margin: 1 0 0 0;
	padding: 0 1;
}

#lists{
	padding: 0 1;
	min-width: 40;
	width: 0.5fr;
}
ListContents > MediaList {
	border-top: white white;
}

ListContents > MediaList:focus-within {
	border-top: solid blue;
}
/* search screen*/
#search-screen-container {
	padding: 2 3;
}

#search-screen-container > Input {
	margin: 1 0;
}

#search-page {
	margin-top: 1;
}

#search-results-container{
	padding: 1 2;
	border: solid rgba(255,255,255, 0.5);
	background: transparent;
}


#search-results-container:focus-within {
	border: solid blue;
	opacity: 1;
}

SearchResultsList, LoadingIndicator {
	background: transparent;
}


#search-results-header, SearchResultItem, MediaItem {
	height: 1;
}

#search-results-header , SearchResultItem Static, MediaItem Static{
	width: 1fr;
	margin: 0 1;
}

MediaItem Static:first-child{
	width: 2fr;
}

.media-item-watched {
	color: rgba(12, 207, 51, 1);
}

.checklist-view{
	background: transparent;
	height: auto;
	border-top: double blue;
	max-height: 20;
}

#search-details-modal {
	padding: 0 1;
	background: rgba(8, 2, 59, 1)
}

#search-details-modal > Static:last-child {
	margin: 1 0 0 0;
}

/* diary entry modal */
#diary-entry-modal {
	padding: 1;
}

#diary-entry-modal > Label{
	margin: 0 0 1 0;
}

#diary-entry-modal > Horizontal {
	align: center middle;
	height: auto;
}

#diary-entry-modal > Container {
	align: center middle;
	height: auto;
}
#diary-entry-modal > Container > Button {
	background: blue;
	margin: 1 0 0 0;
	padding: 0;
}

