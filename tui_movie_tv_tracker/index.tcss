Screen {
}

Pane {
	width: 1fr;
	border: solid white;
	height: 1fr;
}


.pane-window {
	width: 1fr;
	border: solid white;
	padding: 0 1;
	background: transparent;
	color: rgba(255, 255, 255, 0.7);
	opacity: 0.7;
}

.pane-window:focus-within {
	border: double blue;
	opacity: 1;
	color: rgba(255, 255, 255, 1);
}

#lists{
	padding: 0 1;
	min-width: 40;
	width: 0.5fr;
}

/*==========list contents*/
ListContents > MediaList {
	border-top: white white;
	background:transparent;
}

ListContents > MediaList:focus-within {
	border-top: solid blue;
}

ListContents MediaItem {
	height: 1;
}

ListContents MediaItem Label {
	width: 1fr;
}

ListContents MediaItem Label:first-child{
	width: 2fr;
}

/*===============watch stats*/
#watch-stats {
	height: 1fr;
	padding: 0;
	width: auto;
}

WatchStats > Label {
	margin: 1 0 0 1;
}

WatchStats > #watch-stats-numbers{
	width: auto;
	align: center bottom;
	margin: 0 0;
}

WatchStats > #watch-stats-numbers > .watch-stats-bar {
	align: center bottom;
	padding: 0;
	width: 3;
	margin: 0 2;
	height: 1fr;
}

WatchStats > #watch-stats-numbers > .watch-stats-bar > .watch-stats-movie-bar{
	width: 3;
	margin: 0 0;
	height: 0;
	background: #5810b5;
	display: none;
}

WatchStats > #watch-stats-numbers > .watch-stats-bar > .watch-stats-tv-bar{
	width: 3;
	margin: 0 0;
	height: 0;
	background:#1f1485;
	display: none;
}


WatchStats > #watch-stats-months {
	margin: 0 0 1 0;
	width: auto;
	height: auto;
}

WatchStats > #watch-stats-months > Label {
	margin: 0 2;
}

/*==============diary*/
Diary > EntryList {
	background: transparent;
	margin: 1 0 0 0;
}

Diary EntryItem {
	height: 1;
}

Diary EntryItem Label:first-child {
	width: 2;
	margin: 0 4 0 0;
}

/*========gen modal*/
ModalScreen {
	align: center middle;
	background: rgba(0, 0, 0, 0.5); 
}

.modal-container {
	width: 60;
	height: auto;
	padding: 1;
	background: transparent;
	border: solid blue;
}

.modal-input {
	margin: 1 0 0 0;
	padding: 0 1;
}

/*==============search screen*/

#search-screen-container {
	padding: 2 3;
}

#search-screen-container > Input {
	margin: 1 0;
}

#search-page {
	margin-top: 1;
}

#search-results-container{
	padding: 1 2;
	border: solid rgba(255,255,255, 0.5);
	background: transparent;
}


#search-results-container:focus-within {
	border: solid blue;
	opacity: 1;
}

SearchResultsList, LoadingIndicator {
	background: transparent;
}


#search-results-header, SearchResultItem, {
	height: 1;
}

#search-results-header , SearchResultItem Static, {
	width: 1fr;
	margin: 0 1;
}


.media-item-watched {
	color: rgba(12, 207, 51, 1);
}

.checklist-view{
	background: transparent;
	height: auto;
	border-top: double blue;
	max-height: 20;
}

#search-details-modal {
	padding: 0 1;
	background: rgba(8, 2, 59, 1)
}

#search-details-modal > Static:last-child {
	margin: 1 0 0 0;
}

/* ================diary entry modal */

#diary-entry-modal > Label{
	margin: 0 0 1 0;
}

#diary-entry-modal > Horizontal {
	align: center middle;
	height: auto;
}

#diary-entry-modal > Container {
	align: center middle;
	height: auto;
}
#diary-entry-modal > Container > Button {
	background: blue;
	margin: 1 0 0 0;
	padding: 0;
}

